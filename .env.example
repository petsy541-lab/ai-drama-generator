# Environment Configuration

# API Keys (get from respective services)
HUGGINGFACE_API_KEY=
ELEVENLABS_API_KEY=
STABILITY_API_KEY=
FREESOUND_API_KEY=

# Model Settings
VIDEO_MODEL=stabilityai/stable-diffusion-xl-base-1.0
VOICE_MODEL=bark
TEXT_MODEL=meta-llama/Llama-2-7b-hf

# Device (cpu or cuda)
DEVICE=cpu

# Output Quality
VIDEO_FPS=30
VIDEO_RESOLUTION=1920x1080
AUDIO_SAMPLE_RATE=44100

# Logging
LOG_LEVEL=INFO
